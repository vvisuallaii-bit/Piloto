      <span class="fc-chart-title">Recaudación — histórico + proyección</span>
      <div class="fc-chart-legend" id="fc-legend">
        <div class="fc-leg-item"><div class="fc-leg-line" style="background:var(--accent)"></div>Histórico</div>
        <div class="fc-leg-item" id="fc-leg-bad" style="display:none"><div class="fc-leg-line" style="background:var(--red)"></div>Pesimista</div>
        <div class="fc-leg-item" id="fc-leg-base" style="display:none"><div class="fc-leg-line" style="background:var(--amber)"></div>Base</div>
        <div class="fc-leg-item" id="fc-leg-opt" style="display:none"><div class="fc-leg-line" style="background:var(--green)"></div>Optimista</div>
      </div>
    </div>
    <div id="fc-chart-area" style="position:relative;height:240px">
      <div class="fc-empty" id="fc-chart-empty">
        <div class="fc-empty-icon">📊</div>
        Generate your forecast to see the proyección chart
      </div>
      <canvas id="fc-chart" style="display:none"></canvas>
    </div>
  </div>

  <!-- Scenario cards (hidden until forecast) -->
  <div class="fc-scenarios" id="fc-scenarios" style="display:none">
    <!-- Populated by JS -->
  </div>

  <!-- Quick questions (hidden until forecast) -->
  <div class="fc-questions-card" id="fc-questions-card" style="display:none">
    <div class="fc-q-header">
      <div class="fc-ai-dot" style="width:7px;height:7px;border-radius:50%;background:var(--accent);animation:aipulse 2s ease-in-out infinite"></div>
      <span class="fc-q-title">Pregunta sobre tu proyección</span>
      <span class="fc-q-badge">Respuestas rápidas</span>
    </div>
    <div class="fc-q-grid" id="fc-q-grid">
      <!-- Populated by JS -->
    </div>
  </div>

  <!-- Answer panel -->
  <div class="fc-answer-card" id="fc-answer-card">
    <div class="fc-answer-head">
      <div class="fc-ai-dot" style="width:7px;height:7px;border-radius:50%;background:var(--accent);animation:aipulse 2s ease-in-out infinite;flex-shrink:0"></div>
      <span class="fc-answer-q" id="fc-answer-q"></span>
      <button class="fc-answer-x" onclick="closeFcAnswer()">✕</button>
    </div>
    <div class="fc-answer-body" id="fc-answer-body"></div>
  </div>

</div><!-- /tab-forecast -->

</div><!-- /page -->

