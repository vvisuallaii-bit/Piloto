<!-- REVENUE FORECAST -->
<div class="tab-pane" id="tab-forecast">

  <!-- Hero / Controls -->
  <div class="fc-hero">
    <div class="fc-hero-left">
      <h2>📈 Proyección de Ingresos</h2>
      <p>Con base en tus datos históricos, la IA proyecta tu próximo mes en 3 escenarios — para tomar decisiones de contratación, compras y agenda con confianza.</p>
    </div>
    <div class="fc-hero-right">
      <span class="fc-decision-label">Estoy decidiendo sobre:</span>
      <select class="fc-decision-select" id="fc-decision">
        <option value="general">Panorama general</option>
        <option value="hiring">Contratar un higienista</option>
        <option value="equipment">Comprar equipo</option>
        <option value="saturday">Abrir los sábados</option>
        <option value="promotion">Lanzar una promoción</option>
        <option value="insurance">Salir de un seguro</option>
        <option value="expansion">Expandir la clínica</option>
      </select>
      <button class="fc-gen-btn" id="fc-gen-btn" onclick="generateForecast()">
        <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        Generar Proyección
      </button>
    </div>
  </div>

  <!-- Accuracy tracker (shown after first forecast) -->
  <div class="fc-accuracy-bar" id="fc-accuracy-bar">
    <span class="fc-acc-icon">🎯</span>
    <div class="fc-acc-txt" id="fc-acc-txt">Last month we projected <strong>$87,400</strong> (base scenario). You ended at <strong>$91,200</strong> — 4.3% above forecast.</div>
    <span class="fc-acc-pill good" id="fc-acc-pill">+4.3% vs forecast</span>
  </div>

  <!-- Chart -->
  <div class="fc-chart-card">
